rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH', 'GERENTE_OPERACIONES'] ||
         request.auth.uid == userId);
    }
    match /invitations/{invitationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH'];
    }
    match /notifications/{notificationId} {
      allow create: if false;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /fcmTokens/{token} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    // ═══ FASE 0 — Catálogos maestros y Ubicaciones (aditivo) ═══
    // Solo Director General y RRHH administran los catálogos; cualquier
    // usuario autenticado puede leerlos (los módulos futuros los consultan).
    function isCatalogAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'RRHH'];
    }
    match /locationTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /locationGroups/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /locations/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /suppliers/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /productCategories/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /unitsOfMeasure/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /costCenters/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /salesChannels/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /clients/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /controlTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /controlAssignments/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    // ═══ FASE 0 — Alertas de controles: RRHH/Directorio pueden crear notificaciones ═══
    match /notifications/{notificationId} {
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH', 'GERENTE_OPERACIONES'];
    }
    match /{collection}/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
