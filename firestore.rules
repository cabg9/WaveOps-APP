rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH', 'GERENTE_OPERACIONES'] ||
         request.auth.uid == userId);
    }
    match /invitations/{invitationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH'];
    }
    match /notifications/{notificationId} {
      allow create: if false;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /fcmTokens/{token} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    // ═══ FASE 0 — Catálogos maestros y Ubicaciones (aditivo) ═══
    // Solo Director General y RRHH administran los catálogos; cualquier
    // usuario autenticado puede leerlos (los módulos futuros los consultan).
    function isCatalogAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'RRHH'];
    }
    match /locationTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /locationGroups/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /locations/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /suppliers/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /productCategories/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /unitsOfMeasure/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /costCenters/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /salesChannels/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /clients/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /controlTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /controlAssignments/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /controlTargetTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    // ═══ FASE 0 — Alertas de controles: RRHH/Directorio pueden crear notificaciones ═══
    // (ampliado Fase 1 Ronda 3: supervisores y gerentes de departamento también
    // crean notificaciones operativas, ej. aprobación de descuento de renta)
    match /notifications/{notificationId} {
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DIRECTOR_GENERAL', 'DIRECTOR', 'RRHH', 'GERENTE_OPERACIONES', 'GERENTE_DEPARTAMENTO', 'SUPERVISOR'];
    }
    // ═══ FASE 1 — Inventario / Warehouse (aditivo) ═══
    // Config (catálogos de tipos) solo admin de catálogos. Stock, transferencias,
    // conteos y seriales los opera también el personal de Warehouse (cualquier
    // usuario autenticado escribe, igual que el resto de la app). El kardex
    // (inventoryMovements) es INMUTABLE: solo creación, nadie edita ni borra.
    match /movementTypes/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /serialStatuses/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /inventoryStocks/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /inventoryTransfers/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /countSessions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /rentalUnits/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /rentalOrders/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /rentalOrderStatuses/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    // Descuentos preconfigurados de renta: config de catálogo (igual que
    // movementTypes/serialStatuses/rentalOrderStatuses)
    match /rentalDiscounts/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    // Impuestos y cargos configurables de renta: config de catálogo
    match /rentalFees/{docId} {
      allow read: if request.auth != null;
      allow write: if isCatalogAdmin();
    }
    match /inventoryMovements/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /{collection}/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
